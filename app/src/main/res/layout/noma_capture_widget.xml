<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noma_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/noma_widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/noma_widget_ink"
        android:textStyle="bold"
        android:textSize="20sp"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/widget_hint"
        android:textColor="@color/noma_widget_secondary"
        android:textSize="13sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/noma_widget_new_note"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:background="@drawable/noma_widget_button"
        android:text="@string/widget_new_note"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/noma_widget_on_action"
        android:clickable="true"
        android:contentDescription="@string/widget_accessibility" />
</LinearLayout>
