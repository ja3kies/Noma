<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noma_widget_capture" android:layout_width="match_parent"
    android:layout_height="match_parent" android:minHeight="56dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingHorizontal="12dp" android:background="@drawable/noma_widget_material_surface"
    android:importantForAccessibility="yes"
    android:contentDescription="@string/shortcut_new_note_detail">
    <ImageView android:layout_width="36dp" android:layout_height="36dp"
        android:src="@drawable/noma_launcher_foreground" android:contentDescription="@null"/>
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:text="@string/shortcut_new_note"
        android:textColor="@color/noma_widget_material_text" android:textSize="14sp" android:textStyle="bold"
        android:ellipsize="end" android:singleLine="true"/>
</LinearLayout>
